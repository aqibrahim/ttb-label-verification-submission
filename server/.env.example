# Copy this file to .env and fill in real values. .env is gitignored.

# Base URL of the vision-language model's messages/completions endpoint.
MODEL_API_URL=https://api.anthropic.com/v1/messages

# API key for the model provider above.
MODEL_API_KEY=

# Model identifier to request.
MODEL_NAME=claude-sonnet-4-6

# Port the API server listens on.
PORT=4000
